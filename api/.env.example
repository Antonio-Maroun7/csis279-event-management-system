# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Database (PostgreSQL) ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=event_management_system

# ── Authentication (JWT) ──────────────────────────────────────
# Use a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d


# ── Two-factor authentication ─────────────────────────────────
# Key used to encrypt the 2FA secrets in the database (any long random string).
# Do not change it after users enabled 2FA.
TWO_FACTOR_ENCRYPTION_KEY=a6a27898fc28112e73a51d394f6cd9915215a8840d4edc35fa858bcbd9bdce0c